{
  "name": "sidenote-youtube",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "旁听：YouTube 双语字幕与 AI 学习扩展",
  "scripts": {
    "build": "tsx scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:ads": "playwright test --config tests/content/playwright.config.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "format": "prettier --write src tests scripts extension *.json *.md"
  },
  "dependencies": {
    "fast-xml-parser": "^5.3.0",
    "fflate": "^0.8.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.55.0",
    "@types/chrome": "^0.1.25",
    "@types/node": "^22.18.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.0"
  }
}
