{
  "name": "sidenote-youtube",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "旁听：YouTube 双语字幕与 AI 学习扩展",
  "scripts": {
    "build": "tsx scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src server tests scripts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:ads": "playwright test --config tests/content/playwright.config.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run server:build",
    "format": "prettier --write src server tests scripts extension *.json *.md",
    "server": "tsx server/index.ts",
    "server:dev": "tsx watch server/index.ts",
    "server:build": "tsx scripts/build-server.ts",
    "server:start": "node dist-server/index.js"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "fast-xml-parser": "^5.3.0",
    "fastify": "^5.12.3",
    "fflate": "^0.8.2",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.55.0",
    "@types/chrome": "^0.1.25",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22"
  }
}
