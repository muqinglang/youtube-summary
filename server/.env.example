# 会话签名密钥，至少 32 位。泄露等同于所有账号可被冒用。
SIDENOTE_SESSION_SECRET=change-me-to-a-long-random-string

# 托管模式消费的服务商凭据。只存在于服务端进程，绝不下发给客户端。
SIDENOTE_PROVIDER=openai
SIDENOTE_MODEL=gpt-4.1-mini
SIDENOTE_API_KEY=

# 省略则使用内存存储，重启后账号与缓存全部丢失，仅适合本地调试。
# DATABASE_URL=postgres://user:password@localhost:5432/sidenote

# 单账号每日可启动的托管任务数，超出后引导用户改用自己的 Key。
SIDENOTE_DAILY_JOB_LIMIT=20

# 允许跨域调用的来源，逗号分隔。扩展页面的来源形如 chrome-extension://<扩展ID>
SIDENOTE_CORS_ORIGINS=

PORT=8787
