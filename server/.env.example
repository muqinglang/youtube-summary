# 会话签名密钥，至少 32 位。泄露等同于所有账号可被冒用。
SIDENOTE_SESSION_SECRET=change-me-to-a-long-random-string

# 托管模式消费的服务商凭据。只存在于服务端进程，绝不下发给客户端。
SIDENOTE_PROVIDER=openai
SIDENOTE_MODEL=gpt-4.1-mini
SIDENOTE_API_KEY=

# Google OAuth 客户端 ID。托管模式只支持 Google 登录，服务端不保存任何密码。
# 必须与扩展 src/shared/google.ts 里的 GOOGLE_CLIENT_ID 完全一致：服务端会校验每个
# 登录凭证的 aud 等于这个值，否则别的应用签发的凭证就能登进来。
SIDENOTE_GOOGLE_CLIENT_ID=

# 省略则使用内存存储，重启后账号与缓存全部丢失，仅适合本地调试。
# DATABASE_URL=postgres://user:password@localhost:5432/sidenote

# 跨视频知识库的向量服务。留空则该功能整体关闭，其余功能不受影响。
# Anthropic 没有 embedding 接口，用 Claude 跑对话时必须另配一家。
# 默认指向阿里云百炼（大陆可直连、OpenAI 兼容）。维度必须等于模型实际输出的维度。
SIDENOTE_EMBEDDING_API_KEY=
# SIDENOTE_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# SIDENOTE_EMBEDDING_MODEL=text-embedding-v3
# SIDENOTE_EMBEDDING_DIMENSIONS=1024
# SIDENOTE_EMBEDDING_BATCH=10

# 单账号每日可启动的托管任务数，超出后引导用户改用自己的 Key。
SIDENOTE_DAILY_JOB_LIMIT=20

# 允许跨域调用的来源，逗号分隔。扩展页面的来源形如 chrome-extension://<扩展ID>
SIDENOTE_CORS_ORIGINS=

PORT=8787
